  "narrative": {
    "northStar": "The Contemporary Street Atlas",
    "overview": "Glim is an operating workspace for finding public cameras geographically and watching their available visuals. Paper panels, slate cartography, compact geographic indexes, and restrained blue selection keep the map and camera legible together.\n\nThe visual signature is continuity: a selected camera row corresponds to a precise map point and its inline viewer. Camera names, operator credits, feed formats, and playback states carry the meaning.",
    "keyCharacteristics": [
      "Compact paper-and-slate workspace.",
      "Geographic selection expressed consistently in blue.",
      "One self-hosted sans family.",
      "Explicit source, format, and playback labels."
    ],
    "rules": [
      {
        "name": "The State Truth Rule",
        "body": "A blue stream-source marker describes the catalog format; only the player's actual playback state can say “Playing live.” Color never replaces its label.",
        "section": "colors"
      },
      {
        "name": "The Attached Selection Rule",
        "body": "Keep index selection, geographic position, and camera viewer linked to the same stable camera ID.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do preserve the selected camera's identity across row, map point, title, and feed.",
      "Do keep source format, playback state, and capture freshness distinct.",
      "Do retain readable labels, keyboard focus, and reachable pane navigation.",
      "Do show operator credit and recovery actions beside the relevant feed."
    ],
    "donts": [
      "Don't infer working playback from a catalog entry, marker color, or loaded operator frame.",
      "Don't crop camera media to fill decorative cards.",
      "Don't invent camera visuals or substitute unrelated imagery after a source failure.",
