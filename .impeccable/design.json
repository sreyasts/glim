      "css": ".ds-nav{height:59px;background:#fff;border-top:1px solid var(--line,#dfe5e9);display:flex;align-items:stretch;font-family:'DM Sans Variable',sans-serif;}.ds-nav button{display:flex;align-items:center;justify-content:center;flex:1;gap:7px;font:inherit;font-size:11px;color:#596b78;border:0;background:none;cursor:pointer;transition:background-color 150ms,color 150ms}.ds-nav button[aria-pressed=true]{color:var(--blue,#245dd9);background:#f0f5ff}.ds-nav button:focus-visible{outline:3px solid var(--focus,#326be0);outline-offset:3px}.ds-nav button:disabled{opacity:.45;cursor:not-allowed}"
