      "css": ".ds-search{display:flex;align-items:center;gap:9px;padding:4px 5px 4px 11px;border:1px solid #c8d1d8;border-radius:7px;background:#fff;color:#61707c;font-family:'DM Sans Variable',sans-serif;}.ds-search input{width:100%;min-width:0;border:0;outline:0;color:var(--ink,#1c2832);font:inherit;font-size:12px;padding:8px 0;background:transparent}.ds-search input::placeholder{color:#63717d}.ds-search:focus-within{border-color:var(--blue,#245dd9);box-shadow:0 0 0 2px #245dd91a}.ds-search button{background:#edf2fa;border:0;border-radius:5px;width:31px;height:31px;display:grid;place-items:center;color:#2454b7;flex-shrink:0;cursor:pointer}.ds-search button:hover{background:#dce7fa}.ds-search button:focus-visible{outline:3px solid var(--focus,#326be0);outline-offset:3px}.ds-search button:disabled{opacity:.45;cursor:not-allowed}"
    },
