PORT=3001
HOST=127.0.0.1
APP_ORIGIN=http://localhost:5173
DATABASE_PATH=./data/glim.sqlite
# Production: set APP_ORIGIN to your HTTPS domain and NODE_ENV=production.
# Optional background browser notifications. Generate once: npm run push:keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com
# Free Open-Meteo is for non-commercial use. Commercial deployments need a plan.
OPEN_METEO_API_KEY=
# Default: 5 minutes. Minimum: 60 seconds.
POLL_INTERVAL_MS=300000
